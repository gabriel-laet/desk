#!/usr/bin/env python3
"""Third-party-shaped mouse adapter used by Phase 1 tests and the README.

Implements mouse.host_switch with the same argv as mxswitch: --info | 1|2|3.
Not a product helper — drop into ~/.local/lib/desk/ to prove discovery.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

STATE_PATH = Path(os.environ.get("DUMMY_MOUSE_STATE", "/tmp/desk-dummy-mouse.json"))


def load_channel() -> int:
    try:
        raw = json.loads(STATE_PATH.read_text())
        channel = int(raw.get("channel", 1))
        if channel in (1, 2, 3):
            return channel
    except (OSError, json.JSONDecodeError, TypeError, ValueError):
        pass
    return 1


def save_channel(channel: int) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps({"channel": int(channel)}) + "\n")


def main(argv: list[str]) -> int:
    if argv in (["--info"], ["info"]):
        channel = load_channel()
        print(f"device     : dummy-mouse")
        print(f"channels   : 3, currently on {channel}")
        return 0
    if len(argv) == 1 and argv[0] in ("1", "2", "3"):
        dest = int(argv[0])
        save_channel(dest)
        print(f"Switching to channel {dest} ...")
        return 0
    print("usage: dummy-mouse {1|2|3|--info}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
