{
  "adapters": {
    "mouse": {
      "enabled": true,
      "backend": "mxswitch"
    },
    "keyboard": {
      "enabled": true,
      "backend": "hhkb"
    },
    "display": {
      "backend": "lgdualup"
    },
    "hosts": {
      "this_host": "mac",
      "follow_channel": 2,
      "mac": {
        "channel": 1
      },
      "linux": {
        "channel": 2
      },
      "follow_keyboard_arrival": true,
      "arrival_moves_display": true,
      "follow_hhkb_usb": true
    },
    "dualup": {
      "enabled": true,
      "pbp_mode": "50-50",
      "switch_pbp": false,
      "display_id": "",
      "inputs": {
        "mac": "hdmi1",
        "linux": "dp"
      },
      "pbp_splits": {
        "side": 5,
        "stacked": null
      }
    },
    "smarthome": {
      "enabled": true,
      "backend": "alexa",
      "device": "DeviceName"
    },
    "kettle": {
      "enabled": true,
      "backend": "kettle",
      "host": "YOUR_HOST"
    },
    "weather": {
      "enabled": true,
      "backend": "weather",
      "latitude": 0,
      "longitude": 0,
      "timezone": "UTC",
      "label": "Home"
    },
    "wallpaper": {
      "enabled": false,
      "landscape": "~/Pictures/wallpaper-landscape.jpg",
      "portrait": "~/Pictures/wallpaper-portrait.jpg",
      "exact_dir": "~/Pictures/wallpapers",
      "exact_prefix": "desk",
      "primary_output": "",
      "outputs": {}
    }
  },
  "hhkb_vendor_id": 1278,
  "hhkb_product_id": 22,
  "poll_interval_s": 0.5,
  "absent_polls_required": 4,
  "sleep_gap_s": 3.0,
  "switch_retries": 8,
  "switch_retry_delay_s": 0.6,
  "layouts": {
    "focus": {
      "monitors": {
        "display": { "mode": "full", "host": "mac" }
      }
    },
    "split": {
      "monitors": {
        "display": {
          "mode": "pbp",
          "top": "mac",
          "bottom": "linux",
          "split": "stacked"
        }
      }
    }
  },
  "ui": {
    "tray": {
      "density": "strip",
      "lights": false,
      "slots": [
        { "id": "weather", "enabled": true, "kind": "chip", "show_altitude": true },
        { "id": "kettle", "enabled": true, "kind": "face" },
        { "id": "dualup", "enabled": true, "kind": "mode" },
        { "id": "lights", "enabled": false, "kind": "toggle" }
      ]
    },
    "hud": {
      "show_faces": true,
      "density": "regular"
    }
  }
}
