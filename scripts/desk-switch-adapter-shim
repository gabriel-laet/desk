#!/bin/sh
# Compat shim: desk-switch adapter backend.
# Real helper lives under ~/.local/lib/desk-switch/. Prefer `desk-switch`.
ADAPTER="${DESK_SWITCH_ADAPTER:-$(basename "$0")}"
LIBDIR="${DESK_SWITCH_LIB:-$HOME/.local/lib/desk-switch}"
HELPER="$LIBDIR/$ADAPTER"
if [ -x "$HELPER" ]; then
  exec "$HELPER" "$@"
fi
echo "desk-switch: $ADAPTER adapter helper not found at $HELPER — run make install" >&2
exit 127
